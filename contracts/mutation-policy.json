{
  "version": 2,
  "authority": {
    "window_ceiling": "Requester set the ledger ceiling to ten",
    "coordinator_review_threshold": "Requester set review after three unreviewed failed windows; valid review advances the watermark and success does not"
  },
  "window_ceiling": 10,
  "coordinator_review_threshold": 3,
  "frozen_paths": [
    ".gitignore",
    "SKILL.md",
    "agents/openai.yaml",
    "contracts/mutation-policy.json",
    "references/kernel.md",
    "scripts/deadline_harness.py",
    "scripts/mutation_guard.py",
    "tests/test_deadline_harness.py",
    "tests/test_mutation_guard.py"
  ],
  "scopes": {
    "worker": {
      "allowed_paths": [
        "policy/orchestration.json"
      ],
      "evidence_kind": "worker_failure"
    },
    "coordinator": {
      "allowed_paths": [
        "policy/orchestration.json",
        "policy/execution.json",
        "policy/proof.json"
      ],
      "evidence_kind": "coordinator_review"
    }
  },
  "quality_predicates": [
    "worker_executed",
    "test_completed",
    "acceptance_passed",
    "evidence_valid"
  ],
  "efficiency_reductions": [
    "critical_path",
    "serialized_wait",
    "context_tokens",
    "repeated_work",
    "build_or_live_cost",
    "idle_time"
  ],
  "policy_schemas": {
    "policy/orchestration.json": {
      "version": [1],
      "ready_order": ["fs_order", "critical_path_then_fs", "unblock_then_critical_path"],
      "parallelism": ["conservative_disjoint", "maximal_disjoint"],
      "profile_route": ["weakest_sufficient", "risk_weighted"],
      "context_route": ["minimal_contract", "minimal_plus_interface"],
      "receipt_route": ["receipt_only_if_sufficient", "receipt_then_named_selector"],
      "retry_route": ["same_worker_changed_evidence", "replace_worker_changed_owner"],
      "coordinator_flow": ["ledger_dispatch_gate", "dependency_wave_gate", "discriminator_first_gate"],
      "worker_flow": ["implement_test_receipt", "discriminate_implement_test_receipt", "tool_preflight_implement_test_receipt"],
      "tooling_route": ["existing_capabilities_first", "capability_gap_then_focused_adapter"],
      "progress_route": ["terminal_receipt", "milestone_then_terminal_receipt"]
    },
    "policy/execution.json": {
      "version": [1],
      "preflight_route": ["identity_owner_discriminator", "owner_discriminator_identity"],
      "evidence_route": ["owner_test_artifact_live", "artifact_owner_test_live"],
      "integration_route": ["accepted_frontier"],
      "recovery_route": ["reconcile_then_resume", "quarantine_then_replan"],
      "live_route": ["cheapest_remaining", "final_integration_only"],
      "build_route": ["smallest_owner_test_first", "targeted_compile_then_owner_test"],
      "harness_route": ["observer_before_live", "focused_adapter_before_live"]
    },
    "policy/proof.json": {
      "version": [1],
      "conformance_route": ["minimal_authoritative_conformance", "authoritative_owner_then_live_conformance"]
    }
  }
}
